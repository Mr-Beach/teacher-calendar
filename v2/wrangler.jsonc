// v2's Worker (PLAN-v2-phase1.md, decision 2): its own Worker and its own
// Workers Build (root directory v2/), in front of v1's on a few paths.
// Each teacher gets a route pair below; every other path on beach-math.com
// (/math6, /math78, /teacher, apps) still goes to v1's Worker.
// Deploy: a push to main that touches v2/, engine.py, render.py, or
// scripts/lookahead*.py runs its Workers Build (connected 10/9; those are
// its watch paths). By hand: uv run pywrangler deploy.
{
  "name": "teacher-calendar-v2",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  // engine.py and render.py are the repo root's, copied in on every build
  // and dev run, so v1 and v2 always run one engine (decision 1). So are
  // scripts/lookahead*.py, for /edit/<calendar>/ahead (decision 7).
  "build": { "command": "cp ../engine.py ../render.py ../scripts/lookahead.py ../scripts/lookahead_page.py src/" },
  "routes": [
    { "pattern": "beach-math.com/demo/*", "zone_name": "beach-math.com" },
    { "pattern": "www.beach-math.com/demo/*", "zone_name": "beach-math.com" },
    // Signed-in only: the Access app "beach-math.com" must cover these
    // paths too, and the Worker checks its token on every request anyway.
    { "pattern": "beach-math.com/edit", "zone_name": "beach-math.com" },
    { "pattern": "www.beach-math.com/edit", "zone_name": "beach-math.com" },
    { "pattern": "beach-math.com/edit/*", "zone_name": "beach-math.com" },
    { "pattern": "www.beach-math.com/edit/*", "zone_name": "beach-math.com" },
    { "pattern": "beach-math.com/api/*", "zone_name": "beach-math.com" },
    { "pattern": "www.beach-math.com/api/*", "zone_name": "beach-math.com" }
  ],
  // The Access app's team and audience tag (neither is secret: both are
  // in every token). access.verify accepts only tokens for this app.
  "vars": {
    "TEAM_DOMAIN": "https://beach-math.cloudflareaccess.com",
    "ACCESS_AUD": "3e2baf895240ceac1559d297f04dd29b73ad038ffbc2e82b7aca61c1b00ec520"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "teacher-calendar-v2", "database_id": "e36dfb8e-ed59-44ad-a5b0-e6ce84ac0ea8" }
  ],
  "observability": { "enabled": true }
}
